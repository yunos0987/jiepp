(*{#:0 'iec_61131-3/samples/nosplit.iec'}*)
(* nosplit.iec - Forward statements that contain commas with __nosplit *)

(* GUARD takes exactly two arguments *)


(* WHEN_RUNNING forwards a whole statement block as the second argument of *)
(* GUARD. Without __nosplit, the commas in "1, 2:" would split the block    *)
(* into more arguments than GUARD takes (PP34).                            *)


function_block Sorter
var_input
    running: bool;
    item_type: int;
end_var
var
    gate, rejected: int;
end_var
(* A call that spans several lines is output as one line; the blank lines  *)
(* after it keep the line numbers of the following code unchanged.         *)
if running then case item_type of 1, 2: gate := 1; 3: gate := 2; else gate := 0; rejected := rejected + 1; end_case; end_if;







end_function_block
