(*{#:0 'iec_61131-3/samples/pp_number.iec'}*)
(* pp_number.iec - a number with letters after it is one token *)

(* Macros named like the units of a time literal ... *)



program Main
var
    t: time;
    n: int;
end_var
(* ... do not expand inside the literal: t#10ms and t#1m30s stay as written. *)
t := t#10ms;
t := t#1m30s;
(* A separate name still expands. *)
n := 1000;
n := 60;
end_program
