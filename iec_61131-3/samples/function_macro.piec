(* function_macro.iec - Function macros *)




program Main
var
    x, y, result: int;
end_var
(*{st}*)
result := SEL((x) > (y), (y), (x));
result := SEL((0) > (SEL((x) > (100), (x), (100))), (SEL((x) > (100), (x), (100))), (0));
(*{end}*)
end_program
